# ---------------------------------------------------------------------------
# DeepSeek API (required for the conversational Agent endpoint)
# The pure recommendation endpoint (/api/v1/recommend/user/{user_id}) does not
# call an LLM, but the FastAPI service also builds the Agent workflow at start.
# Copy this file to `.env` and replace the placeholder. Never commit `.env`.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=3

# Optional explicit HTTP proxy for the DeepSeek client.
# DEEPSEEK_PROXY=http://127.0.0.1:7897

# ---------------------------------------------------------------------------
# Optional API authentication and CORS
# Leave RECSYS_API_KEY empty to keep local endpoints open.
# ---------------------------------------------------------------------------
# RECSYS_API_KEY=your_local_api_key
# RECSYS_CORS_ORIGINS=http://localhost:8000

# Docker Compose host port
# RECSYS_API_PORT=8000

# Optional application settings
# APP_LOG_LEVEL=INFO
